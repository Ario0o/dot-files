/* ~/.config/rofi/wallpaper-picker.rasi */

* {
    /* Gruvbox Material Dark Palette */
    bg0: #282828;
    bg1: #3c3836;
    bg2: #504945;
    fg0: #ddc7a1;
    fg1: #d4be98;
    accent: #a9b665; /* Green */
    red: #ea6962;    /* Red (used for selection border) */
    
    /* Font settings */
    font: "JetBrainsMono Nerd Font 10";
}

configuration {
    show-icons: true;
    icon-size: 12em; /* Adjusted size to fit better */
    display-drun: "";
    drun-display-format: "{icon}";
    disable-history: true;
}

/* Main Window */
window {
    width: 80%;
    height: 55%; /* Reduced height so it doesn't stretch */
    background-color: @bg0;
    border: 2px solid;
    border-color: @accent;
    border-radius: 12px;
    padding: 20px;
}

/* Force the main box to be dark */
mainbox {
    children: [ listview ];
    background-color: @bg0;
}

/* The grid of images */
listview {
    columns: 4;       
    lines: 3;         
    spacing: 15px;    
    background-color: @bg0; /* Forces the grid background to be dark */
    scrollbar: false;
}

element {
    padding: 8px; 
    background-color: transparent;
    border-radius: 8px;
    orientation: vertical;
    spacing: 5px;
}

element-icon {
    size: 12em;
    horizontal-align: 0.5;
    vertical-align: 0.5;
    background-color: transparent;
}

/* Completely disable text so it doesn't create white space */
element-text {
    enabled: false;
}

element selected {
    background-color: @bg2;
    border: 2px solid;
    border-color: @red;
}