* {
    bg0: #282828;
    bg1: #3c3836;
    bg2: #504945;
    fg0: #ddc7a1;
    fg1: #d4be98;
    accent: #a9b665;
    red: #ea6962;
    
    /* Font settings */
    font: "JetBrainsMono Nerd Font 10";
}

configuration {
    show-icons: true;
    icon-size: 12em;
    display-drun: "";
    drun-display-format: "{icon}";
    disable-history: true;
}

window {
    width: 80%;
    height: 55%;
    background-color: @bg0;
    border: 2px solid;
    border-color: @accent;
    border-radius: 12px;
    padding: 20px;
}

mainbox {
    children: [ listview ];
    background-color: @bg0;
}

listview {
    columns: 4;       
    lines: 5;
    spacing: 15px;    
    background-color: @bg0; 
    scrollbar: false;
}

element {
    padding: 8px; 
    background-color: transparent;
    border-radius: 8px;
    orientation: vertical;
    spacing: 5px;
}

element-icon {
    size: 12em;
    horizontal-align: 0.5;
    vertical-align: 0.5;
    background-color: transparent;
}

element-text {
    enabled: false;
}

element selected {
    background-color: @bg2;
    border: 2px solid;
    border-color: @red;
}