* {
    font: "JetBrainsMono Nerd Font 11";

    background-color: transparent;

    text-color: #d4be98;
}

window {
    width: 99%;
    height: 99%;

    location: center;
    anchor: center;

    border: 0;
    border-radius: 24px;

    padding: 18px;

    background-color: #282828;
}

mainbox {
    spacing: 16px;

    children: [ inputbar, listview ];
}

inputbar {
    padding: 12px 18px;

    spacing: 12px;

    border-radius: 100px;

    background-color: #32302f;

    children: [ prompt, entry ];
}

prompt {
    enabled: true;

    content: "";

    font: "JetBrainsMono Nerd Font 12";

    text-color: #a89984;

    margin: 0px 4px 0px 0px;
}

entry {
    placeholder: "Search wallpaper...";

    placeholder-color: #a89984;

    text-color: #d4be98;

    background-color: transparent;
}

listview {
    columns: 7;
    lines: 2;

    flow: horizontal;

    fixed-height: true;
    fixed-columns: true;

    cycle: false;

    scrollbar: false;

    spacing: 16px;
}

element {
    orientation: vertical;

    padding: 10px;

    spacing: 10px;

    border-radius: 18px;
}

element selected.normal {
    background-color: #504945;

    border-radius: 18px;
}

element-icon {
    size: 170px;

    border-radius: 14px;

    horizontal-align: 0.5;

    vertical-align: 0.5;
}

element-text {
    horizontal-align: 0.5;

    text-color: #d4be98;
}